{
  "name": "sayelse",
  "version": "0.1.0",
  "description": "A local-first Chrome extension for rewriting selected text through any OpenAI-compatible endpoint.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wxt",
    "typecheck": "wxt prepare && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "wxt build"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@types/chrome": "0.3.0",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@wxt-dev/module-react": "1.2.2",
    "jsdom": "30.1.1",
    "typescript": "7.0.2",
    "vitest": "5.0.1",
    "wxt": "0.21.4"
  }
}
